# POST 6D - RECTILINEAR LATTICE - STAGE 10 - Version 2.2.1

# UNSET PARAMS -- These are default values ONLY — will be overridden if set on command line
param -unset filename="for009"
param -unset last=2000 # Number of particles in your simulation
param -unset filein="beam_stage9_noerr_upt.txt"

# QGSP is the "default" physics use-case for HEP
physics QGSP_BERT_EMX 
param pi=3.1415926 

# CELL PROPERTIES

param ncells=50 # Number of coil-RF cavity-absorber setup we have
param cell_length=780 #mm

# COIL AND SOLENOID PROPERTIES

param coilname1=coil1
param coilname2=coil2
param coilname3=coil3

param solpos1=0.10392354745128908
param coil_length1=103.9672286298555
param coil_radius1=50
param coil_width1=80
param current1=254.59064124165604

param bendpos=0.1
param angle=1.5

param solpos2=0.1632534419674336
param coil_length2=75.96035752816377
param coil_radius2=160
param coil_width2=150
param current2=106.66727909222003

param solpos3=0.29907435658882675
param coil_length3=268.7498739970
param coil_radius3=340
param coil_width3=200
param current3=65.55292707828801

param angle=1.5
param bendpos=0.1


# DIPOLE PROPERTIES

param dipole=0.163
param dipole_length=100

# RF CAVITY

param pres=35 # PRESSURE
param rf_length=80
param rf_fre=0.704
param rf_grad=24.253783241429026
param rf_ph=13.64437472675666

param rf_window_length=0.01 #0.05
param wallthick=$rf_window_length

material H2 Z=1 A=1.01 density=0.000090*$pres pressure=$pres
param cavity_gas=Vacuum
#material cavity_gas H,0.99 O,0.01 density=0.0035 pressure=$pres
#param worldMaterial=H2

# PIPE AND FRINGE FIELDS
param pipe_radius=20 #Mod for GEOERRS:150
param win1out_radius=$pipe_radius-0.000001
param pipe_diameter=2*$pipe_radius
param fringe_length=4*$pipe_radius
param pipe_length=($cell_length-4*($rf_length+2*$wallthick))/2

# ABSORBER WEDGE 
param wedge_window_length=0.04
param half_wedge_length=68
param wedge_apex=140

# CLOSED ORBIT?
param end_z=$cell_length*($ncells+1)+10
param x_last=-0.988
param y_last=-1.57
param x_off=-1.0116445330090018
param y_off=-1.6386567018594498


######################## PARTICLES AND DISTRIBUTION #######################

param first=1
param ref_momentum=193

reference particle=mu+ referenceMomentum=$ref_momentum beamT=1793.78 beamX=$x_off beamY=$y_off noEfield=1 noBfield=1 noEloss=1
beam ascii file=$filein beamX=$x_off-$x_last beamY=$y_off-$y_last
# beam_stage9_noerr_upt.txt or beam_stage10.beam
trackcuts killSecondaries=1
trace nTrace=1


########################## DEFINE STRUCTURES ################################

genericbend solbend fieldWidth=1000 fieldHeight=1000 fieldLength=$dipole_length \
               ironWidth=-1 ironHeight=-1 ironLength=-1 \
               openAperture=1 \
               By=$dipole kill=1 fringe=0 ironColor=1,1,1


fieldexpr fringe_left length=$fringe_length width=2*$pipe_radius height=2*$pipe_radius By=$dipole*((1+exp(5*-z/$pipe_diameter)*cos(5*y/$pipe_diameter))/(1+2*exp(5*-z/$pipe_diameter)*cos(5*y/$pipe_diameter)+exp(2*5*-z/$pipe_diameter))) Bz=-$dipole*exp(5*-z/$pipe_diameter)*sin(5*y/$pipe_diameter)/(1+2*exp(5*-z/$pipe_diameter)*cos(5*y/$pipe_diameter)+exp(2*5*-z/$pipe_diameter)) nX=2 nY=100 nZ=150 
fieldexpr fringe_right length=$fringe_length width=2*$pipe_radius height=2*$pipe_radius By=$dipole*((1+exp(5*z/$pipe_diameter)*cos(5*y/$pipe_diameter))/(1+2*exp(5*z/$pipe_diameter)*cos(5*y/$pipe_diameter)+exp(2*5*z/$pipe_diameter))) Bz=-$dipole*exp(5*z/$pipe_diameter)*sin(5*y/$pipe_diameter)/(1+2*exp(5*z/$pipe_diameter)*cos(5*y/$pipe_diameter)+exp(2*5*z/$pipe_diameter)) nX=2 nY=100 nZ=150 

coil $coilname1 innerRadius=$coil_radius1 outerRadius=$coil_radius1+$coil_width1 length=$coil_length1 material=Cu maxZ=$cell_length maxR=$coil_radius1+4*$coil_width1 #tolerance=0.02
solenoid sol1 coilName=$coilname1 current=$current1 kill=1 
solenoid sol2 coilName=$coilname1 current=-$current1 kill=1 

coil $coilname2 innerRadius=$coil_radius2 outerRadius=$coil_radius2+$coil_width2 length=$coil_length2 material=Cu maxZ=$cell_length maxR=($coil_radius2+4*$coil_width2) #tolerance=0.02
solenoid sol3 coilName=$coilname2 current=$current2 kill=1 
solenoid sol4 coilName=$coilname2 current=-$current2 kill=1 

coil $coilname3 innerRadius=$coil_radius3 outerRadius=$coil_radius3+$coil_width3 length=$coil_length3 material=Cu maxZ=$cell_length maxR=$coil_radius3+4*$coil_width3 #tolerance=0.01
solenoid sol5 coilName=$coilname3 current=$current3 kill=1 
solenoid sol6 coilName=$coilname3 current=-$current3 kill=1 

tubs pipe innerRadius=$pipe_radius outerRadius=$pipe_radius+1 length=$pipe_length kill=1

# -- START CAVITY DEFINITIONS --
pillbox cav00 innerLength=$rf_length irisRadius=$pipe_radius frequency=$rf_fre maxGradient=25.86021019528162 phaseAcc=13.64437472675666 winMat=Be cavityMaterial=$cavity_gas win1Thick=$rf_window_length win1OuterRadius=$win1out_radius win2Thick=$rf_window_length wallThick=$wallthick collarThick=0 kill=1
pillbox cav01 innerLength=$rf_length irisRadius=$pipe_radius frequency=$rf_fre maxGradient=22.57001901928362 phaseAcc=13.64437472675666 winMat=Be cavityMaterial=$cavity_gas win1Thick=$rf_window_length win1OuterRadius=$win1out_radius win2Thick=$rf_window_length wallThick=$wallthick collarThick=0 kill=1
pillbox cav02 innerLength=$rf_length irisRadius=$pipe_radius frequency=$rf_fre maxGradient=26.038532725992823 phaseAcc=13.64437472675666 winMat=Be cavityMaterial=$cavity_gas win1Thick=$rf_window_length win1OuterRadius=$win1out_radius win2Thick=$rf_window_length wallThick=$wallthick collarThick=0 kill=1
pillbox cav03 innerLength=$rf_length irisRadius=$pipe_radius frequency=$rf_fre maxGradient=25.749071811376123 phaseAcc=13.64437472675666 winMat=Be cavityMaterial=$cavity_gas win1Thick=$rf_window_length win1OuterRadius=$win1out_radius win2Thick=$rf_window_length wallThick=$wallthick collarThick=0 kill=1
pillbox cav10 innerLength=$rf_length irisRadius=$pipe_radius frequency=$rf_fre maxGradient=23.166245733868077 phaseAcc=13.64437472675666 winMat=Be cavityMaterial=$cavity_gas win1Thick=$rf_window_length win1OuterRadius=$win1out_radius win2Thick=$rf_window_length wallThick=$wallthick collarThick=0 kill=1
