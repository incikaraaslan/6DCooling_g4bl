# POST 6D - RECTILINEAR LATTICE - STAGE 01 - Version 2.2.1

# UNSET PARAMS -- These are default values ONLY — will be overridden if set on command line
param -unset filename="for009"

# QGSP is the "default" physics use-case for HEP
physics QGSP_BERT_EMX 

param pi=3.1415926

# CELL PROPERTIES

param ncells=30 # Number of coil-RF cavity-absorber setup we have
param cell_length=2200 #mm

# COIL AND SOLENOID PROPERTIES

param coilname=coil

param coil_length=596.9838479171975
param coil_radius=450
param coil_width=225

param solpos=0.21428071133122087
param bendpos=0.1
param current=32.14509719624864
param angle=1.5

# RF CAVITY

param pres=35 # PRESSURE
param rf_grad=22.508192486472524
param rf_length=220
param rf_fre=0.352 #mHz
param rf_ph=32.84244060974717

param rf_window_length=0.1
param wallthick=$rf_window_length

material H2 Z=1 A=1.01 density=0.000090*$pres pressure=$pres
param cavity_gas=Vacuum


# DIPOLE PROPERTIES

param dipole=0.058 # B_0
param dipole_length=100

# PIPE AND FRINGE FIELDS
param pipe_radius=230
param pipe_diameter=2*$pipe_radius
param fringe_length=4*$pipe_radius
param pipe_length=($cell_length-6*($rf_length+2*$wallthick))/2

# ABSORBER WEDGE 
param wedge_window_length=0.3 #0.1
param half_wedge_length=370
param wedge_apex=110

# CLOSED ORBIT?

param x_last=2.600925646
param y_last=-5.907135278
param x_off=-6.321091140656247
param y_off=-11.071212987293226


######################## PARTICLES AND DISTRIBUTION #######################

param first=1
param last=2000 # Number of particles in your simulation

param ref_momentum=204 # reference momentum

reference particle=mu+ referenceMomentum=$ref_momentum beamT=0 beamX=$x_off beamY=$y_off noEfield=1 noBfield=1 noEloss=1
beam ascii file=beam_stage1.beam firstEvent=$first lastEvent=$last beamX=$x_off-$x_last beamY=$y_off-$y_last


trackcuts killSecondaries=1
trace nTrace=1

########################## DEFINE STRUCTURES ################################

genericbend solbend fieldWidth=1000 fieldHeight=1000 fieldLength=$dipole_length \
               ironWidth=-1 ironHeight=-1 ironLength=-1 \
               openAperture=1 \
               By=$dipole kill=1 fringe=0 ironColor=1,1,1


fieldexpr fringe_left length=$fringe_length width=2*$pipe_radius height=2*$pipe_radius By=$dipole*((1+exp(5*-z/$pipe_diameter)*cos(5*y/$pipe_diameter))/(1+2*exp(5*-z/$pipe_diameter)*cos(5*y/$pipe_diameter)+exp(2*5*-z/$pipe_diameter))) Bz=-$dipole*exp(5*-z/$pipe_diameter)*sin(5*y/$pipe_diameter)/(1+2*exp(5*-z/$pipe_diameter)*cos(5*y/$pipe_diameter)+exp(2*5*-z/$pipe_diameter)) nX=2 nY=100 nZ=150 
fieldexpr fringe_right length=$fringe_length width=2*$pipe_radius height=2*$pipe_radius By=$dipole*((1+exp(5*z/$pipe_diameter)*cos(5*y/$pipe_diameter))/(1+2*exp(5*z/$pipe_diameter)*cos(5*y/$pipe_diameter)+exp(2*5*z/$pipe_diameter))) Bz=-$dipole*exp(5*z/$pipe_diameter)*sin(5*y/$pipe_diameter)/(1+2*exp(5*z/$pipe_diameter)*cos(5*y/$pipe_diameter)+exp(2*5*z/$pipe_diameter)) nX=2 nY=100 nZ=150 

coil $coilname innerRadius=$coil_radius outerRadius=$coil_radius+$coil_width length=$coil_length material=Cu maxZ=$cell_length maxR=$coil_radius+4*$coil_width #tolerance=0.02
solenoid sol1 coilName=$coilname current=$current kill=1 
solenoid sol2 coilName=$coilname current=-$current kill=1 

tubs pipe innerRadius=$pipe_radius outerRadius=$pipe_radius+1 length=$pipe_length kill=1

# -- START CAVITY DEFINITIONS --
# Cavity 0 in Cavity Block 0 with gradient 23.43603183096166 MV/m
pillbox cav0_0 innerLength=$rf_length irisRadius=$pipe_radius frequency=$rf_fre maxGradient=23.43603183096166 phaseAcc=$rf_ph winMat=Be cavityMaterial=$cavity_gas win1Thick=$rf_window_length win2Thick=$rf_window_length wallThick=$wallthick collarThick=0 kill=1# Cavity 1 in Cavity Block 0 with gradient 21.357511443100943 MV/m
pillbox cav0_1 innerLength=$rf_length irisRadius=$pipe_radius frequency=$rf_fre maxGradient=21.357511443100943 phaseAcc=$rf_ph winMat=Be cavityMaterial=$cavity_gas win1Thick=$rf_window_length win2Thick=$rf_window_length wallThick=$wallthick collarThick=0 kill=1# Cavity 2 in Cavity Block 0 with gradient 22.19676206564275 MV/m
pillbox cav0_2 innerLength=$rf_length irisRadius=$pipe_radius frequency=$rf_fre maxGradient=22.19676206564275 phaseAcc=$rf_ph winMat=Be cavityMaterial=$cavity_gas win1Thick=$rf_window_length win2Thick=$rf_window_length wallThick=$wallthick collarThick=0 kill=1# Cavity 3 in Cavity Block 0 with gradient 21.73788365481391 MV/m
pillbox cav0_3 innerLength=$rf_length irisRadius=$pipe_radius frequency=$rf_fre maxGradient=21.73788365481391 phaseAcc=$rf_ph winMat=Be cavityMaterial=$cavity_gas win1Thick=$rf_window_length win2Thick=$rf_window_length wallThick=$wallthick collarThick=0 kill=1# Cavity 4 in Cavity Block 0 with gradient 23.859934156992768 MV/m
pillbox cav0_4 innerLength=$rf_length irisRadius=$pipe_radius frequency=$rf_fre maxGradient=23.859934156992768 phaseAcc=$rf_ph winMat=Be cavityMaterial=$cavity_gas win1Thick=$rf_window_length win2Thick=$rf_window_length wallThick=$wallthick collarThick=0 kill=1# Cavity 5 in Cavity Block 0 with gradient 22.796321201862458 MV/m
pillbox cav0_5 innerLength=$rf_length irisRadius=$pipe_radius frequency=$rf_fre maxGradient=22.796321201862458 phaseAcc=$rf_ph winMat=Be cavityMaterial=$cavity_gas win1Thick=$rf_window_length win2Thick=$rf_window_length wallThick=$wallthick collarThick=0 kill=1# Cavity 6 in Cavity Block 0 with gradient 22.908989392949554 MV/m
pillbox cav0_6 innerLength=$rf_length irisRadius=$pipe_radius frequency=$rf_fre maxGradient=22.908989392949554 phaseAcc=$rf_ph winMat=Be cavityMaterial=$cavity_gas win1Thick=$rf_window_length win2Thick=$rf_window_length wallThick=$wallthick collarThick=0 kill=1# Cavity 7 in Cavity Block 0 with gradient 22.537860852317205 MV/m
pillbox cav0_7 innerLength=$rf_length irisRadius=$pipe_radius frequency=$rf_fre maxGradient=22.537860852317205 phaseAcc=$rf_ph winMat=Be cavityMaterial=$cavity_gas win1Thick=$rf_window_length win2Thick=$rf_window_length wallThick=$wallthick collarThick=0 kill=1# Cavity 8 in Cavity Block 0 with gradient 21.175602023667704 MV/m
pillbox cav0_8 innerLength=$rf_length irisRadius=$pipe_radius frequency=$rf_fre maxGradient=21.175602023667704 phaseAcc=$rf_ph winMat=Be cavityMaterial=$cavity_gas win1Thick=$rf_window_length win2Thick=$rf_window_length wallThick=$wallthick collarThick=0 kill=1# Cavity 9 in Cavity Block 0 with gradient 21.981550395247975 MV/m
