place cav260 z=26*$cell_length+$cell_length/2-(2*$rf_length+2*2*$wallthick+$wallthick+$rf_length/2) 
place cav261 z=26*$cell_length+$cell_length/2-($rf_length+2*$wallthick+$wallthick+$rf_length/2)
place cav262 z=26*$cell_length+$cell_length/2-($wallthick+$rf_length/2) 
place cav263 z=26*$cell_length+$cell_length/2+($wallthick+$rf_length/2) 
place cav264 z=26*$cell_length+$cell_length/2+($rf_length+2*$wallthick+$wallthick+$rf_length/2) 
place cav265 z=26*$cell_length+$cell_length/2+(2*$rf_length+2*2*$wallthick+$wallthick+$rf_length/2) 

place cav270 z=27*$cell_length+$cell_length/2-(2*$rf_length+2*2*$wallthick+$wallthick+$rf_length/2) 
place cav271 z=27*$cell_length+$cell_length/2-($rf_length+2*$wallthick+$wallthick+$rf_length/2)
place cav272 z=27*$cell_length+$cell_length/2-($wallthick+$rf_length/2) 
place cav273 z=27*$cell_length+$cell_length/2+($wallthick+$rf_length/2) 
place cav274 z=27*$cell_length+$cell_length/2+($rf_length+2*$wallthick+$wallthick+$rf_length/2) 
place cav275 z=27*$cell_length+$cell_length/2+(2*$rf_length+2*2*$wallthick+$wallthick+$rf_length/2) 

place cav280 z=28*$cell_length+$cell_length/2-(2*$rf_length+2*2*$wallthick+$wallthick+$rf_length/2) 
place cav281 z=28*$cell_length+$cell_length/2-($rf_length+2*$wallthick+$wallthick+$rf_length/2)
place cav282 z=28*$cell_length+$cell_length/2-($wallthick+$rf_length/2) 
place cav283 z=28*$cell_length+$cell_length/2+($wallthick+$rf_length/2) 
place cav284 z=28*$cell_length+$cell_length/2+($rf_length+2*$wallthick+$wallthick+$rf_length/2) 
place cav285 z=28*$cell_length+$cell_length/2+(2*$rf_length+2*2*$wallthick+$wallthick+$rf_length/2) 

place cav290 z=29*$cell_length+$cell_length/2-(2*$rf_length+2*2*$wallthick+$wallthick+$rf_length/2) 
place cav291 z=29*$cell_length+$cell_length/2-($rf_length+2*$wallthick+$wallthick+$rf_length/2)
place cav292 z=29*$cell_length+$cell_length/2-($wallthick+$rf_length/2) 
place cav293 z=29*$cell_length+$cell_length/2+($wallthick+$rf_length/2) 
place cav294 z=29*$cell_length+$cell_length/2+($rf_length+2*$wallthick+$wallthick+$rf_length/2) 
place cav295 z=29*$cell_length+$cell_length/2+(2*$rf_length+2*2*$wallthick+$wallthick+$rf_length/2) 

place cav300 z=30*$cell_length+$cell_length/2-(2*$rf_length+2*2*$wallthick+$wallthick+$rf_length/2) 
place cav301 z=30*$cell_length+$cell_length/2-($rf_length+2*$wallthick+$wallthick+$rf_length/2)
place cav302 z=30*$cell_length+$cell_length/2-($wallthick+$rf_length/2) 
place cav303 z=30*$cell_length+$cell_length/2+($wallthick+$rf_length/2) 
place cav304 z=30*$cell_length+$cell_length/2+($rf_length+2*$wallthick+$wallthick+$rf_length/2) 
place cav305 z=30*$cell_length+$cell_length/2+(2*$rf_length+2*2*$wallthick+$wallthick+$rf_length/2) 
# -- END CAVITY PLACEMENTS --

do i 0 $ncells
place all_wedge z=$i*$cell_length  rotation=X90,Y90 x=$x_off rename=wedge_$i
enddo

do i 0 $ncells
place wedge_window z=$i*$cell_length-$half_wedge_length/2-$wedge_window_length/(cos($wedge_apex/2*$pi/180)) x=$x_off rotation=Y-$wedge_apex/2 color=1,0,1
place wedge_window z=$i*$cell_length+$half_wedge_length/2+$wedge_window_length/(cos($wedge_apex/2*$pi/180)) x=$x_off rotation=Y$wedge_apex/2 color=1,0,1
enddo

########################################################################################################

zntuple output zloop=0:$ncells*$cell_length:$cell_length format=for009 require=PDGid==-13 file=$filename referenceParticle=1