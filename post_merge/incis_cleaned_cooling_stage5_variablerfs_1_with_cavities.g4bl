# POST 6D - RECTILINEAR LATTICE - STAGE 05 - Version 2.2.1

# UNSET PARAMS -- These are default values ONLY — will be overridden if set on command line
param -unset filename="for009"
param -unset last=2000 # Number of particles in your simulation
param -unset final_output="beam_stage5_out"

# QGSP is the "default" physics use-case for HEP
physics QGSP_BERT_EMX 
param pi=3.1415926

# CELL PROPERTIES

param ncells=60 # Number of coil-RF cavity-absorber setup we have
param cell_length=850 #mm

# COIL AND SOLENOID PROPERTIES

param coilname1=coil1
param coilname2=coil2

param coil_length1=134.62322649233093
param coil_radius1=120
param coil_width1=100
param current1=141.6134846490137
param solpos1=0.13495361454679736

param bendpos=0.1
param angle=1.5

param coil_length2=246.57513205137496
param coil_radius2=250
param coil_width2=180
param current2=113.40308930638525
param solpos2=0.3167097423106357

param angle=1.5
param bendpos=0.1

# DIPOLE PROPERTIES

param dipole=0.162
param dipole_length=100

# RF CAVITY

param pres=35 # PRESSURE
param rf_length=100
param rf_fre=0.704
param rf_grad=27.037847343886234
param rf_ph=26.44610506485106

param rf_window_length=0.03
param wallthick=$rf_window_length

material H2 Z=1 A=1.01 density=0.000090*$pres pressure=$pres
param cavity_gas=Vacuum
#material cavity_gas H,0.99 O,0.01 density=0.0035 pressure=$pres
#param worldMaterial=H2

# PIPE AND FRINGE FIELDS
param pipe_radius=60
param pipe_diameter=2*$pipe_radius
param fringe_length=4*$pipe_radius
param pipe_length=($cell_length-4*($rf_length+2*$wallthick))/2

# ABSORBER WEDGE 
param wedge_window_length=0.09
param half_wedge_length=125
param wedge_apex=120

# CLOSED ORBIT?
param end_z=$cell_length*($ncells+1)+10
param x_last=-6.02
param y_last=-6.83
param x_off=-2.945987461999792
param y_off=-3.6150189391649663

######################## PARTICLES AND DISTRIBUTION #######################

param first=1
param ref_momentum=203

reference particle=mu+ referenceMomentum=$ref_momentum beamT=1037.23 beamX=$x_off beamY=$y_off noEfield=1 noBfield=1 noEloss=1
beam ascii file=beam_stage5.beam firstEvent=$first lastEvent=$last beamX=$x_off-$x_last beamY=$y_off-$y_last
# beam_stage4_noerrout.beam
trackcuts killSecondaries=1
trace nTrace=1

virtualdetector beamDet radius=800 length=0.001 filename=$final_output format=ascii


########################## DEFINE STRUCTURES ################################
genericbend solbend fieldWidth=1000 fieldHeight=1000 fieldLength=$dipole_length \
               ironWidth=-1 ironHeight=-1 ironLength=-1 \
               openAperture=1 \
               By=$dipole kill=1 fringe=0 ironColor=1,1,1


fieldexpr fringe_left length=$fringe_length width=2*$pipe_radius height=2*$pipe_radius By=$dipole*((1+exp(5*-z/$pipe_diameter)*cos(5*y/$pipe_diameter))/(1+2*exp(5*-z/$pipe_diameter)*cos(5*y/$pipe_diameter)+exp(2*5*-z/$pipe_diameter))) Bz=-$dipole*exp(5*-z/$pipe_diameter)*sin(5*y/$pipe_diameter)/(1+2*exp(5*-z/$pipe_diameter)*cos(5*y/$pipe_diameter)+exp(2*5*-z/$pipe_diameter)) nX=2 nY=100 nZ=150 
fieldexpr fringe_right length=$fringe_length width=2*$pipe_radius height=2*$pipe_radius By=$dipole*((1+exp(5*z/$pipe_diameter)*cos(5*y/$pipe_diameter))/(1+2*exp(5*z/$pipe_diameter)*cos(5*y/$pipe_diameter)+exp(2*5*z/$pipe_diameter))) Bz=-$dipole*exp(5*z/$pipe_diameter)*sin(5*y/$pipe_diameter)/(1+2*exp(5*z/$pipe_diameter)*cos(5*y/$pipe_diameter)+exp(2*5*z/$pipe_diameter)) nX=2 nY=100 nZ=150 

coil $coilname1 innerRadius=$coil_radius1 outerRadius=$coil_radius1+$coil_width1 length=$coil_length1 material=Cu maxZ=$cell_length maxR=$coil_radius1+4*$coil_width1 #tolerance=0.02
solenoid sol1 coilName=$coilname1 current=$current1 kill=1 
solenoid sol2 coilName=$coilname1 current=-$current1 kill=1 

coil $coilname2 innerRadius=$coil_radius2 outerRadius=$coil_radius2+$coil_width2 length=$coil_length2 material=Cu maxZ=$cell_length maxR=($coil_radius2+4*$coil_width2) #tolerance=0.02
solenoid sol3 coilName=$coilname2 current=$current2 kill=1 
solenoid sol4 coilName=$coilname2 current=-$current2 kill=1 

tubs pipe innerRadius=$pipe_radius outerRadius=$pipe_radius+1 length=$pipe_length kill=1

# -- START CAVITY DEFINITIONS --
pillbox cav00 innerLength=$rf_length irisRadius=$pipe_radius frequency=$rf_fre maxGradient=27.079867119262392 phaseAcc=34.5197019010442 winMat=Be cavityMaterial=$cavity_gas win1Thick=$rf_window_length win2Thick=$rf_window_length wallThick=$wallthick collarThick=0 kill=1
pillbox cav01 innerLength=$rf_length irisRadius=$pipe_radius frequency=$rf_fre maxGradient=27.107854872262166 phaseAcc=36.26989958505419 winMat=Be cavityMaterial=$cavity_gas win1Thick=$rf_window_length win2Thick=$rf_window_length wallThick=$wallthick collarThick=0 kill=1
pillbox cav02 innerLength=$rf_length irisRadius=$pipe_radius frequency=$rf_fre maxGradient=27.225336077187183 phaseAcc=24.828108188541506 winMat=Be cavityMaterial=$cavity_gas win1Thick=$rf_window_length win2Thick=$rf_window_length wallThick=$wallthick collarThick=0 kill=1
pillbox cav03 innerLength=$rf_length irisRadius=$pipe_radius frequency=$rf_fre maxGradient=26.703913640867665 phaseAcc=33.46319378533709 winMat=Be cavityMaterial=$cavity_gas win1Thick=$rf_window_length win2Thick=$rf_window_length wallThick=$wallthick collarThick=0 kill=1
