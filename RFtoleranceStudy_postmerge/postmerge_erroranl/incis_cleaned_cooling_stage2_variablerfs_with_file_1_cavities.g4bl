# POST 6D - RECTILINEAR LATTICE - STAGE 02 - Version 2.2.1

# UNSET PARAMS -- These are default values ONLY — will be overridden if set on command line
param -unset filename="for009"
param -unset last=2000 # Number of particles in your simulation
param -unset filein="beam_stage1_noerr_upt.txt"

# QGSP is the "default" physics use-case for HEP
physics QGSP_BERT_EMX 
param pi=3.1415926

# CELL PROPERTIES

param ncells=40 # Number of coil-RF cavity-absorber setup we have
param cell_length=1800 #mm

# COIL AND SOLENOID PROPERTIES

param coilname=coil

param coil_length=509.8057366700792
param coil_radius=450
param coil_width=225

param solpos=0.19931741627235866
param bendpos=0.1
param current=52.30429801780153
param angle=1.5

# DIPOLE PROPERTIES

param dipole=0.084 # B_0
param dipole_length=100

# RF CAVITY

param pres=35 # PRESSURE
param rf_grad=23.635989510791358
param rf_length=220
param rf_fre=0.352 #mHz
param rf_ph=27.13412117208823

param rf_window_length=0.08 #0.05
param wallthick=$rf_window_length

#material cavity_gas H,0.99 O,0.01 density=0.0035 pressure=$pres
#param worldMaterial=H2
material H2 Z=1 A=1.01 density=0.000090*$pres pressure=$pres
param cavity_gas=Vacuum

# PIPE AND FRINGE FIELDS
param pipe_radius=190
param win1out_radius=$pipe_radius-0.000001
param pipe_diameter=2*$pipe_radius
param fringe_length=4*$pipe_radius
param pipe_length=($cell_length-5*($rf_length+2*$wallthick))/2

# ABSORBER WEDGE 
param wedge_window_length=0.24 #0.1
param half_wedge_length=280 #320
param wedge_apex=120

# CLOSED ORBIT?
param end_z=$cell_length*($ncells+1)+10
param x_last=-6.81
param y_last=-9.84
param x_off=-6.416356483004593
param y_off=-11.353350994123101

######################## PARTICLES AND DISTRIBUTION #######################

param first=1

param ref_momentum=204 # reference momentum

reference particle=mu+ referenceMomentum=$ref_momentum beamT=190.079 beamX=$x_off beamY=$y_off noEfield=1 noBfield=1 noEloss=1
beam ascii file=$filein beamX=$x_off-$x_last beamY=$y_off-$y_last
# beam_stage1_noerr_upt.txt or beam_stage2.beam
trackcuts killSecondaries=1
trace nTrace=1


########################## DEFINE STRUCTURES ################################


genericbend solbend fieldWidth=1000 fieldHeight=1000 fieldLength=$dipole_length \
               ironWidth=-1 ironHeight=-1 ironLength=-1 \
               openAperture=1 \
               By=$dipole kill=1 fringe=0 ironColor=1,1,1


fieldexpr fringe_left length=$fringe_length width=2*$pipe_radius height=2*$pipe_radius By=$dipole*((1+exp(5*-z/$pipe_diameter)*cos(5*y/$pipe_diameter))/(1+2*exp(5*-z/$pipe_diameter)*cos(5*y/$pipe_diameter)+exp(2*5*-z/$pipe_diameter))) Bz=-$dipole*exp(5*-z/$pipe_diameter)*sin(5*y/$pipe_diameter)/(1+2*exp(5*-z/$pipe_diameter)*cos(5*y/$pipe_diameter)+exp(2*5*-z/$pipe_diameter)) nX=2 nY=100 nZ=150 
fieldexpr fringe_right length=$fringe_length width=2*$pipe_radius height=2*$pipe_radius By=$dipole*((1+exp(5*z/$pipe_diameter)*cos(5*y/$pipe_diameter))/(1+2*exp(5*z/$pipe_diameter)*cos(5*y/$pipe_diameter)+exp(2*5*z/$pipe_diameter))) Bz=-$dipole*exp(5*z/$pipe_diameter)*sin(5*y/$pipe_diameter)/(1+2*exp(5*z/$pipe_diameter)*cos(5*y/$pipe_diameter)+exp(2*5*z/$pipe_diameter)) nX=2 nY=100 nZ=150 

coil $coilname innerRadius=$coil_radius outerRadius=$coil_radius+$coil_width length=$coil_length material=Cu maxZ=$cell_length maxR=$coil_radius+4*$coil_width #tolerance=0.02
solenoid sol1 coilName=$coilname current=$current kill=1 
solenoid sol2 coilName=$coilname current=-$current kill=1 

tubs pipe innerRadius=$pipe_radius outerRadius=$pipe_radius+1 length=$pipe_length kill=1

# -- START CAVITY DEFINITIONS --
pillbox cav00 innerLength=$rf_length irisRadius=$pipe_radius frequency=$rf_fre maxGradient=23.635989510791358 phaseAcc=24.303420804250745 winMat=Be cavityMaterial=$cavity_gas win1Thick=$rf_window_length win2Thick=$rf_window_length wallThick=$wallthick collarThick=0 kill=1
pillbox cav01 innerLength=$rf_length irisRadius=$pipe_radius frequency=$rf_fre maxGradient=23.635989510791358 phaseAcc=32.29698127532521 winMat=Be cavityMaterial=$cavity_gas win1Thick=$rf_window_length win2Thick=$rf_window_length wallThick=$wallthick collarThick=0 kill=1
pillbox cav02 innerLength=$rf_length irisRadius=$pipe_radius frequency=$rf_fre maxGradient=23.635989510791358 phaseAcc=24.218998155109144 winMat=Be cavityMaterial=$cavity_gas win1Thick=$rf_window_length win2Thick=$rf_window_length wallThick=$wallthick collarThick=0 kill=1
