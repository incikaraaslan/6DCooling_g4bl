# POST 6D - RECTILINEAR LATTICE - STAGE 04 - Version 2.2.1

# UNSET PARAMS -- These are default values ONLY — will be overridden if set on command line
param -unset filename="for009"
param -unset last=200 # Number of particles in your simulation
param -unset filein="beam_stage3_noerr_upt.txt"

# QGSP is the "default" physics use-case for HEP
physics QGSP_BERT_EMX 
param pi=3.1415926 

# CELL PROPERTIES

param ncells=60 # Number of coil-RF cavity-absorber setup we have
param cell_length=1250 #mm

# COIL AND SOLENOID PROPERTIES

param coilname1=coil1
param coilname2=coil2

param coil_length1=80.49590188750338
param coil_radius1=175
param coil_width1=200
param solpos1=0.10805325236026425
param current1=115.20255175888389

param bendpos=0.1
param angle=1.5

param coil_length2=305.2462411020286
param coil_radius2=450
param coil_width2=225
param current2=110.06448256765512
param solpos2=0.2904738502730546

param angle=1.5
param bendpos=0.1

# DIPOLE PROPERTIES

param dipole=0.155
param dipole_length=100

# RF CAVITY

param pres=35 # PRESSURE

param rf_length=220
param rf_fre=0.352
param rf_grad=24.083104149360217
param rf_ph=27.906663869941873

param rf_window_length=0.045
param wallthick=$rf_window_length


# material H2 Z=1 A=1.01 density=0.000090*$pres pressure=$pres
param cavity_gas=Vacuum
#material cavity_gas H,0.99 O,0.01 density=0.0035 pressure=$pres
#param worldMaterial=H2

# PIPE AND FRINGE FIELDS
param pipe_radius=95
param win1out_radius=$pipe_radius-0.000001
param pipe_diameter=2*$pipe_radius
param fringe_length=4*$pipe_radius
param pipe_length=($cell_length-3*($rf_length+2*$wallthick))/2 # param pipe_length=($cell_length-3*($rf_length+2*$wallthick))/2

# ABSORBER WEDGE 
param wedge_window_length=0.15
param half_wedge_length=200
param wedge_apex=120

# CLOSED ORBIT?
param end_z=$cell_length*($ncells+1)+10
param x_last=-6.4
param y_last=-7.97
param x_off=-5.455087114416996
param y_off=-7.138307420771727

######################## PARTICLES AND DISTRIBUTION #######################

param first=1

param ref_momentum=203

reference particle=mu+ referenceMomentum=$ref_momentum beamT=778.698 beamX=$x_off beamY=$y_off noEfield=1 noBfield=1 noEloss=1
beam ascii file=$filein beamX=$x_off-$x_last beamY=$y_off-$y_last
# beam_stage3_noerr_upt.txt or beam_stage4.beam
trackcuts killSecondaries=1
trace nTrace=1


########################## DEFINE STRUCTURES ################################

genericbend solbend fieldWidth=1000 fieldHeight=1000 fieldLength=$dipole_length \
               ironWidth=-1 ironHeight=-1 ironLength=-1 \
               openAperture=1 \
               By=$dipole kill=1 fringe=0 ironColor=1,1,1


fieldexpr fringe_left length=$fringe_length width=2*$pipe_radius height=2*$pipe_radius By=$dipole*((1+exp(5*-z/$pipe_diameter)*cos(5*y/$pipe_diameter))/(1+2*exp(5*-z/$pipe_diameter)*cos(5*y/$pipe_diameter)+exp(2*5*-z/$pipe_diameter))) Bz=-$dipole*exp(5*-z/$pipe_diameter)*sin(5*y/$pipe_diameter)/(1+2*exp(5*-z/$pipe_diameter)*cos(5*y/$pipe_diameter)+exp(2*5*-z/$pipe_diameter)) nX=2 nY=100 nZ=150 
fieldexpr fringe_right length=$fringe_length width=2*$pipe_radius height=2*$pipe_radius By=$dipole*((1+exp(5*z/$pipe_diameter)*cos(5*y/$pipe_diameter))/(1+2*exp(5*z/$pipe_diameter)*cos(5*y/$pipe_diameter)+exp(2*5*z/$pipe_diameter))) Bz=-$dipole*exp(5*z/$pipe_diameter)*sin(5*y/$pipe_diameter)/(1+2*exp(5*z/$pipe_diameter)*cos(5*y/$pipe_diameter)+exp(2*5*z/$pipe_diameter)) nX=2 nY=100 nZ=150 

coil $coilname1 innerRadius=$coil_radius1 outerRadius=$coil_radius1+$coil_width1 length=$coil_length1 material=Cu maxZ=$cell_length maxR=$coil_radius1+4*$coil_width1 #tolerance=0.02
solenoid sol1 coilName=$coilname1 current=$current1 kill=1 
solenoid sol2 coilName=$coilname1 current=-$current1 kill=1 

coil $coilname2 innerRadius=$coil_radius2 outerRadius=$coil_radius2+$coil_width2 length=$coil_length2 material=Cu maxZ=$cell_length maxR=($coil_radius2+4*$coil_width2) #tolerance=0.02
solenoid sol3 coilName=$coilname2 current=$current2 kill=1 
solenoid sol4 coilName=$coilname2 current=-$current2 kill=1 

tubs pipe innerRadius=$pipe_radius outerRadius=$pipe_radius+1 length=$pipe_length kill=1

# -- START CAVITY DEFINITIONS --
pillbox cav00 innerLength=$rf_length irisRadius=$pipe_radius frequency=$rf_fre maxGradient=24.083104149360217 phaseAcc=24.775523824453494 winMat=Be cavityMaterial=$cavity_gas win1Thick=$rf_window_length win2Thick=$rf_window_length wallThick=$wallthick collarThick=0 kill=1
pillbox cav01 innerLength=$rf_length irisRadius=$pipe_radius frequency=$rf_fre maxGradient=24.083104149360217 phaseAcc=19.12408921953608 winMat=Be cavityMaterial=$cavity_gas win1Thick=$rf_window_length win2Thick=$rf_window_length wallThick=$wallthick collarThick=0 kill=1
pillbox cav02 innerLength=$rf_length irisRadius=$pipe_radius frequency=$rf_fre maxGradient=24.083104149360217 phaseAcc=32.404698501237036 winMat=Be cavityMaterial=$cavity_gas win1Thick=$rf_window_length win2Thick=$rf_window_length wallThick=$wallthick collarThick=0 kill=1
pillbox cav10 innerLength=$rf_length irisRadius=$pipe_radius frequency=$rf_fre maxGradient=24.083104149360217 phaseAcc=19.806073795253848 winMat=Be cavityMaterial=$cavity_gas win1Thick=$rf_window_length win2Thick=$rf_window_length wallThick=$wallthick collarThick=0 kill=1
